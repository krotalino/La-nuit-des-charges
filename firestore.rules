rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'selaboykouotou23@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['nom', 'prenom', 'telephone', 'ville', 'passId']) &&
             data.keys().hasOnly(['nom', 'prenom', 'telephone', 'ville', 'passId', 'createdAt']) &&
             isValidString(data.nom, 1, 100) &&
             isValidString(data.prenom, 1, 100) &&
             isValidString(data.telephone, 6, 30) &&
             isValidString(data.ville, 1, 100) &&
             isValidString(data.passId, 5, 50) &&
             (!('createdAt' in data) || isValidString(data.createdAt, 1, 40));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Registrations collection
    match /registrations/{registrationId} {
      // Guests can submit their RSVP registration
      allow create: if isValidRegistration(request.resource.data);

      // The organizer / admin can read and manage registrations
      allow read, update, delete: if isAdmin();
    }
  }
}
